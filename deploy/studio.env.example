# Install the private copy at /etc/prelude/studio.env with mode 0600, owned by root.
# This file uses systemd EnvironmentFile syntax; keep values on one line.
PRELUDE_PUBLIC_ORIGIN=https://CHANGE_ME
PRELUDE_DATA_DIR=/var/lib/prelude
PRELUDE_INVITE_ONLY=1
PRELUDE_DAILY_LIMIT_CENTS=3000
DASHSCOPE_API_KEY=
DASHSCOPE_API_HOST=
